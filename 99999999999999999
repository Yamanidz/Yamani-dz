  <script>
(function() {
    function moveCounter() {
        var blogTitle = document.querySelector(&#39;.header-title h1.title&#39;);
        var statsWidget = document.getElementById(&#39;Stats1&#39;);
        
        if (!blogTitle) { return false; }
        if (!statsWidget) { return false; }
        
        var counterContainer = document.createElement(&#39;div&#39;);
        counterContainer.id = &#39;yamani-visitor-counter&#39;;
        counterContainer.style.cssText = &#39;text-align: center; margin: 15px 0 30px 0; padding: 10px 0;&#39;;
        
        blogTitle.parentNode.insertBefore(counterContainer, blogTitle.nextSibling);
        counterContainer.appendChild(statsWidget);
        
        formatCounter(statsWidget);
        
        return true;
    }
    
    function formatCounter(statsElement) {
        var span = statsElement.querySelector(&#39;span&#39;) || statsElement.querySelector(&#39;.counter-wrapper&#39;) || statsElement.querySelector(&#39;div&#39;);
        
        if (!span) { return; }
        
        var originalText = span.textContent.trim();
        var match = originalText.match(/[\d,]+/);
        if (!match) { return; }
        
        var numberStr = match[0].replace(/,/g, &#39;&#39;);
        var originalNumber = parseInt(numberStr);
        
        if (!window.yamaniOriginalNumber) {
            window.yamaniOriginalNumber = originalNumber;
        } else {
            originalNumber = window.yamaniOriginalNumber;
        }
        
        var shortText;
        var fullText;
        
        if (originalNumber &gt;= 1000000000) {
            var formattedNumber = (originalNumber / 1000000000).toFixed(1);
            formattedNumber = formattedNumber.replace(&#39;.0&#39;, &#39;&#39;);
            shortText = formattedNumber + &#39; مليار مشاهدة&#39;;
        } else if (originalNumber &gt;= 1000000) {
            var formattedNumber = (originalNumber / 1000000).toFixed(1);
            formattedNumber = formattedNumber.replace(&#39;.0&#39;, &#39;&#39;);
            shortText = formattedNumber + &#39; مليون مشاهدة&#39;;
        } else if (originalNumber &gt;= 1000) {
            var formattedNumber = (originalNumber / 1000).toFixed(1);
            formattedNumber = formattedNumber.replace(&#39;.0&#39;, &#39;&#39;);
            shortText = formattedNumber + &#39; ألف مشاهدة&#39;;
        } else {
            shortText = originalNumber + &#39; مشاهدة&#39;;
        }
        
        fullText = originalNumber.toLocaleString(&#39;ar&#39;) + &#39; مشاهدة&#39;;
        
        var title = statsElement.querySelector(&#39;h2&#39;);
        if (title) { 
            title.style.display = &#39;none&#39;; 
        }
        
        span.textContent = shortText;
        
        span.style.cursor = &#39;pointer&#39;;
        span.onclick = function() {
            if (this.textContent === shortText) {
                this.textContent = fullText;
            } else {
                this.textContent = shortText;
            }
        };
        
        span.style.cssText = &#39;color: #ffffff !important; font-size: 22px !important; font-weight: bold !important; font-family: &quot;DM Serif Display&quot;, serif !important; text-align: center !important; display: block !important; cursor: pointer !important; margin: 0 !important; padding: 0 !important;&#39;;
    }
    
    if (document.readyState === &#39;loading&#39;) {
        document.addEventListener(&#39;DOMContentLoaded&#39;, function() {
            setTimeout(moveCounter, 1000);
        });
    } else {
        setTimeout(moveCounter, 1000);
    }
    
    window.addEventListener(&#39;load&#39;, function() {
        setTimeout(function() {
            var statsWidget = document.getElementById(&#39;Stats1&#39;);
            if (statsWidget) {
                var span = statsWidget.querySelector(&#39;span&#39;) || statsWidget.querySelector(&#39;.counter-wrapper&#39;);
                if (span) {
                    var currentText = span.textContent;
                    if (currentText) {
                        if (currentText.includes(&#39;مشاهدة&#39;)) {
                            window.yamaniFinalText = currentText;
                        }
                    }
                }
            }
        }, 3000);
    });
    
    setInterval(function() {
        var span = document.querySelector(&#39;#Stats1 span&#39;) || document.querySelector(&#39;#Stats1 .counter-wrapper&#39;);
        if (span) {
            if (window.yamaniFinalText) {
                if (!span.textContent.includes(&#39;مشاهدة&#39;)) {
                    span.textContent = window.yamaniFinalText;
                } else {
                    if (span.textContent) {
                        if (!span.textContent.includes(&#39;ألف&#39;)) {
                            if (!span.textContent.includes(&#39;مليون&#39;)) {
                                if (!span.textContent.includes(&#39;مليار&#39;)) {
                                    span.textContent = window.yamaniFinalText;
                                }
                            }
                        }
                    }
                }
            }
        }
    }, 1000);
    
    setTimeout(function() {
        if (!document.getElementById(&#39;yamani-visitor-counter&#39;)) {
            moveCounter();
        }
    }, 3000);
})();
</script>
